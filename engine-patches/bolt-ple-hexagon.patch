+void llama_model::verify_ple_rows(const int32_t * rows, size_t n_rows) const {
+    if (ple_row_sha256.empty() || n_rows == 0) {
+        return;
+    }
+    const auto * t = per_layer_tok_embd;
+    if (!rows || !t || !t->data || !t->buffer || !ggml_backend_buffer_is_host(t->buffer)) {
+        throw std::runtime_error("required PLE rows are not available on the host");
+    }
+    std::vector<int32_t> unique(rows, rows + n_rows);
+    std::sort(unique.begin(), unique.end());
+    unique.erase(std::unique(unique.begin(), unique.end()), unique.end());
+    const size_t row_bytes = ggml_row_size(t->type, t->ne[0]);
+    for (const int32_t row : unique) {
+        if (row < 0 || row >= t->ne[1]) {
+            throw std::runtime_error("PLE row index out of range");
+        }
+        unsigned char digest[SHA256_DIGEST_SIZE];
+        const auto * data = (const unsigned char *) t->data + (size_t) row * t->nb[1];
+        sha256_hash(digest, data, row_bytes);
+        if (memcmp(digest, ple_row_sha256.data() + (size_t) row * SHA256_DIGEST_SIZE, SHA256_DIGEST_SIZE) != 0) {
+            throw std::runtime_error("PLE integrity check failed for row " + std::to_string(row));
+        }
+    }
+}
